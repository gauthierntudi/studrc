# Apps — MAGAZINE v2
# Copier vers v2/.env (jamais committer le vrai .env)
# Domaine : opt1mum.com

NODE_ENV=production
APP_URL=https://opt1mum.com
API_URL=https://api.opt1mum.com
NEXT_PUBLIC_API_URL=https://api.opt1mum.com
# SSR Docker (optionnel — déjà défaut dans docker-compose.yml)
API_INTERNAL_URL=http://api:3001

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_DOMAIN=.opt1mum.com

# PostgreSQL (VPS Docker) — ou managed
DATABASE_URL=postgresql://opt1mum:opt1mum@postgres:5432/magazine

# Redis (VPS Docker) — ou managed
REDIS_URL=redis://redis:6379

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=magazine-prod
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.opt1mum.com
# true seulement si le custom domain R2 (cdn…) a bien un DNS
AVATAR_USE_CDN=false

# Stripe (carte) — LIVE uniquement
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# FlexPaie / FlexPay (mobile)
FLEXPAIE_MERCHANT=
FLEXPAIE_TOKEN=
FLEXPAIE_MOBILE_API_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAIE_CARD_API_URL=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAIE_CHECK_API_URL=https://backend.flexpay.cd/api/rest/v1/check
FLEXPAIE_CALLBACK_URL=https://api.opt1mum.com/payments/flexpaie/callback

# Email — Resend
RESEND_API_KEY=re_...
MAIL_FROM=Optimum <noreply@opt1mum.com>

# Admin (seed)
ADMIN_EMAIL=admin@opt1mum.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Administrateur

# Google Sign-In (GSI) — Client ID OAuth Web
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
