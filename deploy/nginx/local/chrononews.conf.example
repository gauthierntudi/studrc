# Copier vers chrononews.conf sur le VPS (fichier gitignored) :
#   cp deploy/nginx/local/chrononews.conf.example deploy/nginx/local/chrononews.conf
#
# Prérequis : le conteneur chrononews-nginx est sur le réseau magazine_default
# avec l'alias DNS `chrononews` (voir /opt/chrononews/docker-compose.yml).

upstream chrononews_upstream {
    server chrononews:80;
}

server {
    listen 80;
    server_name chrononews.cd www.chrononews.cd;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name chrononews.cd www.chrononews.cd;

    ssl_certificate     /etc/letsencrypt/live/chrononews.cd/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chrononews.cd/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 50M;

    location / {
        proxy_pass http://chrononews_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
